# Generic provider config (recommended)
# Supported providers: morpheus, openrouter, kimi-code, kimi, other
PROVIDER=morpheus
API_KEY=YOUR_API_KEY
MODEL=venice-uncensored
# Optional OpenAI-compatible /v1 base URL or full /chat/completions endpoint.
# Leave blank to use the provider default.
# BASE_URL=https://api.mor.org/api/v1

# PoQ post-generation quality gate
POQ_ENABLED=true
POQ_MIN_SCORE=7
POQ_MAX_RETRIES=1
POQ_OVERFITTING_CHECK=true

# OpenRouter example:
# PROVIDER=openrouter
# API_KEY=YOUR_OPENROUTER_API_KEY
# MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free
# BASE_URL=https://openrouter.ai/api/v1

# Kimi Code membership API example:
# PROVIDER=kimi-code
# API_KEY=YOUR_KIMI_CODE_API_KEY
# MODEL=kimi-for-coding
# BASE_URL=https://api.kimi.com/coding/v1

# Kimi Platform API example:
# PROVIDER=kimi
# API_KEY=YOUR_KIMI_PLATFORM_API_KEY
# MODEL=kimi-k2.6
# BASE_URL=https://api.moonshot.ai/v1

# Legacy fallback (used if PROVIDER/API_KEY/MODEL are not set):
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
# OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free

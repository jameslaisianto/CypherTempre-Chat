# SurplusIntelligence provider configuration
PROVIDER=surplusintelligence
API_KEY=
MODEL=gpt-5.5
BASE_URL=https://api.surplusintelligence.ai/v1

# Image generation and editing/redefinition
IMAGE_PROVIDER=surplusintelligence
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_EDIT_MODEL=
IMAGE_BASE_URL=https://api.surplusintelligence.ai/v1

# Video generation, image-to-video, and remix/extension
VIDEO_PROVIDER=surplusintelligence
VIDEO_API_KEY=
VIDEO_MODEL=
VIDEO_BASE_URL=https://api.surplusintelligence.ai/v1

# Audio generation
AUDIO_PROVIDER=surplusintelligence
AUDIO_API_KEY=
AUDIO_MODEL=
AUDIO_BASE_URL=https://api.surplusintelligence.ai/v1

# PoQ post-generation quality gate
POQ_ENABLED=true
POQ_MIN_SCORE=7
POQ_MAX_RETRIES=1
POQ_OVERFITTING_CHECK=true
in-mistral-24b-venice-edition:free
